+        self.assertEqual(self.archive.writer.read(self.photos/'IMG_0001.JPG')['XMP-fk:SKU'],'中文 Ab-001')
+        self.api.request_items.clear()
+        self.assertEqual(self.api.metadata_write_state(self.rid)['progress'],state['progress'])
