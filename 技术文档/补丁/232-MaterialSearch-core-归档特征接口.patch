@@ -0,0 +1,137 @@
+"""独立特征接口契约；替身不作为模型识别准确率的证据。"""
+from concurrent.futures import ThreadPoolExecutor
+import importlib
+import subprocess
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+import torch
+
+from materialsearch_core.embeddings import FeatureEncoder
+
+
+class FakeProcessor:
+    def __init__(self): self.calls = []
+
+    def __call__(self, **kwargs):
+        self.calls.append(kwargs)
+        count = len(kwargs.get('images', kwargs.get('text', [])))
+        if 'images' in kwargs: return {'pixel_values': torch.ones((count, 3))}
+        return {'input_ids': torch.ones((count, 2), dtype=torch.long),
+                'attention_mask': torch.ones((count, 2), dtype=torch.long)}
+
+
+class FakeModel:
+    def __init__(self): self.pooled = False; self.output = None; self.grad_flags = []
+
+    def features(self, rows):
+        self.grad_flags.append(torch.is_grad_enabled())
+        output = self.output if self.output is not None else torch.tensor([[3., 4.] for _ in range(rows)])
+        return SimpleNamespace(pooler_output=output) if self.pooled else output
+
+    def get_image_features(self, pixel_values): return self.features(len(pixel_values))
+
+    def get_text_features(self, input_ids, attention_mask):
+        assert torch.equal(attention_mask, torch.ones_like(input_ids))
+        return self.features(len(input_ids))
+
+
+class EncoderTests(unittest.TestCase):
+    def setUp(self):
+        self.model, self.processor = FakeModel(), FakeProcessor()
+        self.loader = self.enterContext(patch('materialsearch_core.embeddings._load_components',
+                                             return_value=(self.model, self.processor)))
+        self.encoder = FeatureEncoder('fixture-snapshot', dimension=2, max_batch_size=2)
+
+    def test_import_does_not_initialize_model_stack_config_or_database(self):
+        code = "from materialsearch_core.embeddings import FeatureEncoder; import sys; e=FeatureEncoder('fixture'); assert not e.loaded; assert not any(n in sys.modules for n in ('torch','transformers','materialsearch_core.config','materialsearch_core.models')); print('inert')"
+        result = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, check=True)
+        self.assertEqual(result.stdout.strip(), 'inert')
+
+    def test_image_and_text_share_one_lazy_model_and_float32_units(self):
+        self.assertFalse(self.encoder.loaded); self.loader.assert_not_called()
+        image = self.encoder.encode_images([object(), object()])
+        text = self.encoder.encode_texts(['红色衣服'])
+        self.assertEqual(image.shape, (2, 2)); self.assertEqual(text.shape, (1, 2))
+        self.assertEqual(image.dtype, np.float32)
+        np.testing.assert_allclose(np.linalg.norm(image, axis=1), 1)
+        np.testing.assert_allclose(image[0], text[0])
+        self.loader.assert_called_once_with('fixture-snapshot', 'cpu', True)
+        self.assertEqual(self.model.grad_flags, [False, False])
+
+    def test_pooled_output_is_supported(self):
+        self.model.pooled = True
+        np.testing.assert_allclose(self.encoder.encode_images([object()]), [[.6, .8]])
+
+    def test_attention_mask_and_text_truncation_are_preserved(self):
+        self.encoder.encode_texts(['短句', '另一个句子'])
+        call = self.processor.calls[-1]
+        self.assertTrue(call['padding']); self.assertTrue(call['truncation'])
+        self.assertEqual(call['max_length'], 52)
+
+    def test_invalid_batch_does_not_load_model(self):
+        for value in ([], None, 'path.jpg', [None], [object()] * 3):
+            with self.subTest(value=str(value)), self.assertRaises(ValueError): self.encoder.encode_images(value)
+        for value in ([''], ['  '], [123], [None]):
+            with self.subTest(value=value), self.assertRaises(ValueError): self.encoder.encode_texts(value)
+        self.loader.assert_not_called()
+
+    def test_zero_nonfinite_wrong_dimension_and_wrong_rows_are_rejected(self):
+        for output in (torch.zeros((1, 2)), torch.tensor([[float('nan'), 1]]),
+                       torch.tensor([[float('inf'), 1]]), torch.ones((1, 3)),
+                       torch.ones((2, 2)), torch.ones(2)):
+            self.model.output = output
+            with self.subTest(shape=tuple(output.shape)), self.assertRaises(ValueError): self.encoder.encode_images([object()])
+
+    def test_dimension_is_inferred_and_shared_across_images_and_text(self):
+        encoder = FeatureEncoder('fixture')
+        encoder.encode_images([object()]); self.assertEqual(encoder.dimension, 2)
+        self.model.output = torch.ones((1, 3))
+        with self.assertRaises(ValueError): encoder.encode_texts(['文字'])
+
+    def test_model_load_failure_can_retry_without_partial_state(self):
+        self.loader.side_effect = [RuntimeError('fixture load error'), (self.model, self.processor)]
+        with self.assertRaisesRegex(RuntimeError, 'fixture load error'): self.encoder.encode_images([object()])
+        self.assertFalse(self.encoder.loaded)
+        self.encoder.encode_images([object()]); self.assertTrue(self.encoder.loaded)
+
+    def test_concurrent_callers_only_load_once(self):
+        with ThreadPoolExecutor(max_workers=3) as pool:
+            results = list(pool.map(lambda _: self.encoder.encode_images([object()]), range(6)))
+        self.assertEqual(len(results), 6); self.loader.assert_called_once()
+
+    def test_close_releases_and_reloads(self):
+        self.encoder.encode_images([object()]); self.encoder.close(); self.assertFalse(self.encoder.loaded)
+        self.encoder.encode_images([object()]); self.assertEqual(self.loader.call_count, 2)
+
+    def test_constructor_rejects_invalid_configuration(self):
+        for options in ({'dimension': 0}, {'max_batch_size': True}, {'max_text_length': 0}, {'local_files_only': 'false'}):
+            with self.subTest(options=options), self.assertRaises(ValueError): FeatureEncoder('fixture', **options)
+
+    def test_legacy_entrypoints_share_lazy_encoder_accept_pil_and_keep_empty_semantics(self):
+        # 原生扩展须在 sys.modules 替换范围外加载，避免撤销替身时卸载后重复初始化。
+        import cv2
+        from PIL import Image
+        config = ModuleType('materialsearch_core.config')
+        for name, value in {'MODEL_NAME':'fixture', 'DEVICE':'cpu', 'SCAN_PROCESS_BATCH_SIZE':2}.items():
+            setattr(config, name, value)
+        with patch.dict(sys.modules, {'materialsearch_core.config': config}):
+            legacy = importlib.import_module('materialsearch_core.process_assets')
+        try:
+            self.loader.assert_not_called()
+            self.assertIsNone(legacy.get_image_feature(None))
+            self.assertIsNone(legacy.get_image_feature([]))
+            self.assertIsNone(legacy.process_text(''))
+            image = legacy.get_image_feature(Image.new('RGB', (64, 64), 'red'))
+            text = legacy.process_text('红色')
+            np.testing.assert_allclose(image, text)
+            self.loader.assert_called_once_with('fixture', 'cpu', False)
+        finally:
+            legacy.encoder.close()
+            sys.modules.pop('materialsearch_core.process_assets', None)
+
+
+if __name__ == '__main__': unittest.main()
