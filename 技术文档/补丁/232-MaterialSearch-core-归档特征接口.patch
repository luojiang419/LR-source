+"""验证原 SQLAlchemy/SQLite 表和搜索接口能在独立文件中直接复用。"""
+from contextlib import closing
+import datetime
+import importlib
+from pathlib import Path
+import sqlite3
+import sys
+import tempfile
+from types import ModuleType
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+
+class UpstreamDatabaseTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.import_temp = tempfile.TemporaryDirectory()
+        config = ModuleType('materialsearch_core.config')
+        values = {'SQLALCHEMY_DATABASE_URL':'sqlite:///' + str(Path(cls.import_temp.name)/'unused-default.db'),
+                  'MODEL_NAME':'fixture-no-download','DEVICE':'cpu','SCAN_PROCESS_BATCH_SIZE':2,
+                  'CACHE_SIZE':4,'POSITIVE_THRESHOLD':0,'NEGATIVE_THRESHOLD':100,'IMAGE_THRESHOLD':85}
+        for name, value in values.items(): setattr(config, name, value)
+        cls.config_patch = patch.dict(sys.modules, {'materialsearch_core.config':config})
+        cls.config_patch.start()
+        cls.models = importlib.import_module('materialsearch_core.models')
+        cls.database = importlib.import_module('materialsearch_core.database')
+        cls.search = importlib.import_module('materialsearch_core.search')
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.search.clean_cache(); cls.models.engine.dispose()
+        cls.config_patch.stop()
+        for name in ('search','database','models','process_assets'):
+            sys.modules.pop('materialsearch_core.' + name, None)
+        cls.import_temp.cleanup()
+
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(); self.base = Path(self.temp.name)
+        self.visual = self.base/'visual-search'/'assets.db'; self.visual.parent.mkdir()
+        self.engine = create_engine('sqlite:///' + str(self.visual))
+        self.models.BaseModel.metadata.create_all(bind=self.engine)
+        self.sessions = sessionmaker(bind=self.engine)
+        self.search_patch = patch.object(self.search, 'DatabaseSession', self.sessions); self.search_patch.start()
+        self.search.clean_cache()
+        self.modified = datetime.datetime(2026,11,14,12,0)
+
+    def tearDown(self):
+        self.search.clean_cache(); self.search_patch.stop(); self.engine.dispose(); self.temp.cleanup()
+
+    def add(self, path, checksum, vector):
+        with self.sessions() as session:
+            self.database.add_image(session,path,self.modified,checksum,np.asarray(vector,dtype=np.float32).tobytes())
+            return session.query(self.models.Image).filter_by(path=path).one().id
+
+    def test_original_schema_and_image_id_search_use_only_separate_database(self):
+        metadata = self.base/'asset_catalog.sqlite3'
+        with closing(sqlite3.connect(metadata)) as c:
+            with c:
+                c.execute('CREATE TABLE items(id TEXT,sku TEXT)'); c.execute("INSERT INTO items VALUES('asset','LC1234')")
+        image_id = self.add('red.jpg', 'a'*40, [1,0])
+        self.add('blue.jpg', 'b'*40, [0,1])
+        result = self.search.search_image_by_image(image_id)
